{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".."
  },
  "include": ["**/*.ts", "../part2/pages/**/*.ts", "../part2/utils/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
